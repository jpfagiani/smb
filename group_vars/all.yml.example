# =============================================================================
# CDPNI — Variáveis padrão
# Este arquivo é SOBRESCRITO pelo bootstrap.sh com os valores interativos.
# Edite manualmente apenas se não usar o bootstrap.
# Nunca use este arquivo em produção sem alterar as senhas.
# =============================================================================

# Identidade da unidade — exibida no portal web e no certificado SSL.
# Para instalar em outra unidade, o bootstrap pergunta
# estes valores; nomes técnicos internos (serviço portal-samba, paths)
# não mudam e não precisam mudar.
org:
  name:     "CDPNI"
  fullname: "Centro de Detenção Provisória de Nova Independência"

server:
  ip:         "10.14.29.11"
  mask:       "24"
  gateway:    "10.14.29.1"
  dns:        "10.14.29.1"
  # NTP institucional da intranet (GPU); se removido, usa o gateway
  ntp:        "10.14.8.20"
  hostname:   "cdpni"
  domain:     "cdpni.local"
  admin_user: "sambadmin"
  iface:      "eth0"

# Redes com acesso permitido aos serviços (SSH, SMB, portal, painel).
# Além das faixas privadas RFC 1918, inclui as faixas legadas do CDPNI
# que ficam FORA do espaço privado: 172.14.29.0/24 e 192.14.29.0/24 são
# endereços PÚBLICOS reutilizados internamente — funciona atrás do
# gateway, mas sites reais da internet nessas faixas ficam inacessíveis.
# Sobreposições entre faixas são permitidas (o nftables usa auto-merge).
network_ranges:
  - "10.0.0.0/8"        # RFC 1918 — cobre a rede padrão 10.14.29.0/24
  - "172.16.0.0/12"     # RFC 1918
  - "192.168.0.0/16"    # RFC 1918
  - "172.14.29.0/24"    # faixa CDPNI legada (fora do RFC 1918)
  - "192.14.29.0/24"    # faixa CDPNI legada (fora do RFC 1918)

raid:
  level:   5
  # Trava anti-formatação: a role storage só formata discos que contêm
  # assinaturas de instalação anterior se isto for true. O bootstrap
  # pergunta e grava; em edição manual, declare a intenção aqui.
  confirmo_formatacao: false
  mount:   /mnt/raid
  device:  /dev/md0
  devices:
    - /dev/sdb
    - /dev/sdc
    - /dev/sdd
    - /dev/sde
    - /dev/sdf

samba:
  workgroup:    "WORKGROUP"
  # Nomes extras pelos quais o servidor responde no Windows, sem servidor DNS
  # (ex.: http://portal e \\portal). Registrados por NetBIOS pelo nmbd.
  # Três regras para o apelido funcionar:
  #   1. SEM PONTOS — o NetBIOS só conhece nomes de um rótulo. "portal.cdpni"
  #      exigiria servidor DNS; "portal-cdpni", com hífen, funciona.
  #   2. Até 15 caracteres.
  #   3. Diferente do workgroup acima: os clientes já registram o workgroup
  #      como nome de GRUPO, que nunca resolve para o endereço de uma máquina.
  netbios_aliases: ["PORTAL", "PORTAL-CDPNI"]
  default_pass: "ALTERAR_NO_BOOTSTRAP"
  log_dir:      /var/log/samba
  # Usuários com bypass de permissão no Samba (admin users)
  # Populado dinamicamente pelo bootstrap — não editar manualmente
  extra_admins: []

portal:
  # Nome do portal. Convenção <servidor>-portal: amarra o portal ao servidor
  # que o hospeda. Daqui saem a unidade systemd, o site do nginx, o serviço
  # PAM, o sudoers, a jail do fail2ban e os arquivos de log.
  # Ao trocar, rode scripts/renomear_portal.sh para migrar o que já existe.
  nome: portal-samba
  dir:  /opt/portal-samba      # mantenha igual a /opt/<nome>
  user: cdpni
  port: 5000

# ── Portas de outros sistemas nesta máquina ─────────────────────────────────
# O firewall tem política DROP: o que não estiver liberado some da rede sem
# aviso. Se a máquina também roda GWOS (DNS 53, hora 123, painel 8080) ou
# outro portal, liste as portas aqui. O bootstrap detecta e preenche sozinho.
firewall:
  extra_tcp: []      # ex.: [53, 8080]
  extra_udp: []      # ex.: [53, 123]

ssl:
  dir:      /etc/nginx/ssl
  cert:     /etc/nginx/ssl/cdpni.crt
  key:      /etc/nginx/ssl/cdpni.key
  days:     3650
  country:  BR
  state:    SP
  org:      CDPNI
